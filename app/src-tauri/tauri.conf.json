{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kenes",
  "version": "0.1.0",
  "identifier": "kz.kenes.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kenes",
        "width": 420,
        "height": 720,
        "minWidth": 320,
        "minHeight": 400,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.6",
      "entitlements": "Entitlements.plist"
    },
    "category": "Productivity",
    "shortDescription": "Ассистент для встреч на русском и казахском",
    "linux": {
      "deb": {
        "depends": [
          "pulseaudio-utils"
        ]
      }
    }
  }
}